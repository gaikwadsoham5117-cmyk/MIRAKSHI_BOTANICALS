rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "ankitawavecode@gmail.com"
      ); 
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Products: Public can read, admin & store management can write
    match /products/{productId} {
      allow read, write: if true;
    }

    // Settings: Public can read, admin & store management can write
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Ingredients: Public can read, admin & store management can write
    match /ingredients/{ingredientId} {
      allow read, write: if true;
    }

    // Reviews: Public can read, admin & store management can write
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Enquiries: Public can submit enquiry, admin can read/manage
    match /enquiries/{enquiryId} {
      allow create: if incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100
                    && incoming().phone is string && incoming().phone.size() >= 10 && incoming().phone.size() <= 20
                    && incoming().message is string && incoming().message.size() > 0 && incoming().message.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    // Orders: Public can create an order, can read specific order for tracking; admin can manage all
    match /orders/{orderId} {
      allow create: if incoming().orderId is string && incoming().orderId.size() > 0
                    && incoming().customerName is string && incoming().customerName.size() > 0 && incoming().customerName.size() <= 100
                    && incoming().phone is string && incoming().phone.size() >= 10 && incoming().phone.size() <= 20
                    && incoming().amount is number && incoming().amount > 0
                    && incoming().quantity is number && incoming().quantity >= 1
                    && (incoming().paymentMethod == 'online' || incoming().paymentMethod == 'cod');
      allow get: if true; // Allows order tracking by exact Order ID
      allow list, update, delete: if isAdmin();
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable directly or initialized
    }

    // FCM Device Tokens for Free Mobile Push Notifications
    match /fcm_tokens/{tokenId} {
      allow read, write: if true;
    }
  }
}
