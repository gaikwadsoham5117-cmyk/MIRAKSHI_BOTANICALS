{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Herbal hair oil product details and pricing",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "brand": { "type": "string", "maxLength": 100 },
        "previousBrand": { "type": "string", "maxLength": 100 },
        "size": { "type": "string", "maxLength": 50 },
        "price": { "type": "number" },
        "codCharge": { "type": "number" },
        "inStock": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 2000 },
        "benefits": { "type": "array" },
        "imageUrl": { "type": "string", "maxLength": 1000 }
      },
      "required": ["name", "price", "size"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order details",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "maxLength": 50 },
        "customerName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "email": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 500 },
        "city": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 100 },
        "pincode": { "type": "string", "maxLength": 10 },
        "quantity": { "type": "number" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["online", "cod"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid", "failed"] },
        "orderStatus": { "type": "string", "enum": ["Order Placed", "Confirmed", "Processing", "Shipped", "Out for Delivery", "Delivered", "Cancelled"] },
        "trackingNumber": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["orderId", "customerName", "phone", "address", "quantity", "amount", "paymentMethod", "orderStatus"]
    },
    "Enquiry": {
      "title": "Enquiry",
      "description": "Customer contact query",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "email": { "type": "string", "maxLength": 100 },
        "message": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["new", "contacted", "resolved"] },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "phone", "message"]
    },
    "Review": {
      "title": "Review",
      "description": "Real verified customer review managed by admin",
      "type": "object",
      "properties": {
        "customerName": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "review": { "type": "string", "maxLength": 1000 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["customerName", "rating", "review"]
    },
    "Ingredient": {
      "title": "Ingredient",
      "description": "Botanical ingredient information",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "benefits": { "type": "string", "maxLength": 500 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "active": { "type": "boolean" }
      },
      "required": ["name", "description"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Website global configuration and content",
      "type": "object",
      "properties": {
        "brandName": { "type": "string", "maxLength": 100 },
        "previousBrandName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "whatsapp": { "type": "string", "maxLength": 20 },
        "heroHeading": { "type": "string", "maxLength": 200 },
        "heroSubheading": { "type": "string", "maxLength": 500 },
        "onlinePrice": { "type": "number" },
        "codCharge": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Catalog of botanical products"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer purchase orders"
    },
    "/enquiries/{enquiryId}": {
      "schema": "Enquiry",
      "description": "Customer inquiries and contact forms"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Curated customer reviews"
    },
    "/ingredients/{ingredientId}": {
      "schema": "Ingredient",
      "description": "Nature-inspired ingredients details"
    },
    "/settings/{settingId}": {
      "schema": "Settings",
      "description": "Store configuration"
    }
  }
}
